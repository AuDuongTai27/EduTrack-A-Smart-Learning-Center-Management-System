# ==============================================================================
# EduTrack Project .gitignore
# Covering: ASP.NET Core 8 (Backend), React + Vite (Frontend), OS & Editors
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Sensitive Configs (Bảo mật tài khoản & khóa API)
# ------------------------------------------------------------------------------
# Frontend Environment files
.env
.env.local
.env.*.local
.env.development
.env.production
!.env.example

# Backend Sensitive Configurations & Secrets
appsettings.Development.json
appsettings.Local.json
appsettings.Production.json
# (appsettings.json template remains tracked, secrets go into user-secrets or local configs)

# Certificates & Private Keys
*.pfx
*.p12
*.key
*.pem

# ------------------------------------------------------------------------------
# 2. Frontend (Node.js / React / Vite / TypeScript)
# ------------------------------------------------------------------------------
# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
dist-ssr/
build/
out/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Vite cache & temp
.vite/
.eslintcache
.stylelintcache
.turbo/

# ------------------------------------------------------------------------------
# 3. Backend (.NET / C# / ASP.NET Core)
# ------------------------------------------------------------------------------
# Build & Compilation Results
bin/
obj/
[Bb]in/
[Oo]bj/

# User-specific & local files
*.suo
*.user
*.userprefs
*.userosscache
*.sln.docstates

# Visual Studio / Rider cache
.vs/
.idea/
*.rsuser

# EF Core / DB Temporary Migrations (nếu sinh file tạm)
*.db
*.db-shm
*.db-wal

# ------------------------------------------------------------------------------
# 4. Editors & OS
# ------------------------------------------------------------------------------
# VS Code (Giữ lại cấu hình chung nếu cần, bỏ file trạng thái)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
